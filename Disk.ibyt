// Disk - drives under Linux: check names, read /sys and /proc, list the drives.
// All queries refer to the drive whose name is in Disk.Name (e.g. "sdb", "nvme0n1", "mmcblk0").

public byte Name[32]                // name of the drive, e.g. sdb
public byte Path[128]               // built path /sys/block/<Name><suffix>
public byte Text[512]               // text read from /sys files (also the model name)
public byte Prefix[48]              // "/dev/<Name>"
public byte Num[32]                 // number converted to text
public byte Mounts[65537]           // buffer for the mount table (read in chunks)
public byte Dents[4096]             // directory entries of /sys/block (getdents buffer)

// No single variables: yes/no values are in the flag container Dk, numbers in the data containers Info and State
public flag diskDk{ removable, readOnly, endsDigit, listAll, numbered, collect, mntFull, mountUnsure, mntAny }

public int64 diskPub64{ sectors, listCount, mntCount }           // results for other modules
private int64 diskPri64{ suffixPtr, linePtr, dirFd, dentsLen, dentsPos, showNo, fieldMax, mntFd, mntRem, mntGot, mntTotal, mntCut, mntSaved, padWidth, padText }   // working numbers of this module
private define MNT_CHUNK: 4096                // bytes read from the mount table per read

public byte MntDev[512]             // collected device names (8 x 64 bytes)
public byte MntPt[2048]             // collected mount points (8 x 256 bytes)
public byte Names[512]              // names of the drives found (16 x 32 bytes)
public byte SortTmp[32]             // temporary name while sorting

// SysPath: builds in Path the path "/sys/block/<Name><Suffix>". $base = suffix (e.g. "/size").
prepare $pBase@Suffix
public methode SysPath(base, temp, counter, item, admin){
    
    diskPri64.suffixPtr: $base
    $pBase: Path
    $pTemp: "/sys/block/"
    
    // Path = "/sys/block/" + Name + suffix
    prepare $base, $temp@Source
    call String.StrCopy(=)

    prepare $pBase: Path, $pTemp: Name
    call String.StrCat(=)

    $pBase: Path
    $temp: diskPri64.suffixPtr
    prepare $base, $temp
    call String.StrCat(=)
}

// ReadNum: reads the number from /sys/block/<Name><Suffix>. $base = suffix. carry = 1: $work = number.
prepare $base@Suffix
public methode ReadNum(_, base, temp, focus work, counter, item, admin){
    prepare $base
    call SysPath(=)

    // read the file into Text (at most 512 bytes), then convert it to a number
    $pBase: Path
    $pTemp: Text
    prepare $base, $temp, $work@Size: 512
    call Sys.ReadFile(=)
    goto_flag not_carry Fail

    prepare $pBase: Text
    call Basic.AtoI(=)

    set_carry
    return

    ->Fail->
        unset_carry
}

// CheckName: is $base a valid drive name? Allowed: a-z, 0-9, _ ; 1 to 31 characters. carry = 1: yes
// ****************This Methode ist not activated. DeadCode****************
prepare $pBase@Name
public methode CheckName(_, base, work){
    $work: 0

    ->Loop->
        _: $pBase@Name[$work@Pos]
        compare(_ = 0) goto_true End

        compare(_ < 48) goto_true Bad        // below '0'

        compare(_ <= 57) goto_true Good      // digit

        compare(_ = 95) goto_true Good       // '_'

        compare(_ < 97) goto_true Bad

        compare(_ > 122) goto_true Bad       // only a-z

    ->Good->
        $work++
        goto Loop↑

    ->End->
        compare($work@Len = 0) goto_true Bad

        compare($work > 31) goto_true Bad

        set_carry
        return

    ->Bad->
        unset_carry
}

// Exists: is there the whole drive "Name" under /sys/block? (Partitions are not listed there.) carry = 1: yes
public methode Exists(_, base, temp, counter, item, admin){
    // empty suffix = the directory /sys/block/<Name> itself: it opens only if the whole drive exists
    prepare ""
    call SysPath(=)

    $pBase: Path
    // O_RDONLY | O_DIRECTORY
    prepare 65536, 0, $base
    call Sys.Open(=)
    goto_flag not_carry No

    $base: $counter@Fd
    prepare $base
    call Sys.Close(=)

    set_carry
    return

    ->No->
        unset_carry
}

// Load: reads Removable, ReadOnly and the size of the drive from /sys. carry = 1: ok
public methode Load(_, base, temp, work, counter, item, admin){
    
    // removable flag, read-only flag and size in 512-byte sectors; if one read fails, Load fails
    prepare $pBase@Text: "/removable"
    call ReadNum(=)
    goto_flag not_carry Fail

    diskDk.removable: false
    if ($work@Value = 1){ diskDk.removable: true }

    prepare $pBase@Text: "/ro"
    call ReadNum(=)
    goto_flag not_carry Fail

    diskDk.readOnly: false
    if ($work@Value = 1){ diskDk.readOnly: true }

    prepare $pBase@Text: "/size"
    call ReadNum(=)
    goto_flag not_carry Fail

    diskPub64.sectors: $work@Value
    set_carry
    return

    ->Fail->
        unset_carry
}

// Model: vendor/model text of the drive into Text (without trailing spaces); empty if it cannot be read.
public methode Model(_, base, temp, work, counter, item, admin){
    prepare "/device/model"
    call SysPath(=)

    $pBase: Path
    $pTemp: Text
    prepare $base, $temp, $work@Size: 512
    call Sys.ReadFile(=)
    goto_flag carry Got

    $pBase: Text
    $pBase[0]: 0
    return

    ->Got->
        prepare $pBase@Text: Text
        call String.StrTrimEnd(=)
}

// Prefixes: builds Prefix = "/dev/<Name>" and notes whether the name ends with a digit (then partitions are called "...p1").
public methode Prefixes(_, base, temp, work, counter, item, admin){
    prepare $pBase@Prefix: Prefix, $pTemp@Text: "/dev/"
    call String.StrCopy(=)

    prepare $pBase: Prefix, $pTemp: Name
    call String.StrCat(=)

    // look at the last character of the name
    $work: $counter@Len
    $work--
    $pBase: Prefix
    
    _: $pBase@Prefix[$work@Len]
    diskDk.endsDigit: false
    compare(_ < 48) goto_true Done

    compare(_ > 57) goto_true Done

    diskDk.endsDigit: true

    ->Done->
}

// IsMountedText: does the drive Name (or one of its partitions) appear in the mount table $base? carry = 1: yes
// The table has one line per mount: "<device> <target> ...". Hit: device = /dev/<Name> or /dev/<Name><digit> resp. /dev/<Name>p<digit>.
prepare $pBase@Table
public methode IsMountedText(_, base, temp, work, index, value, counter, item, admin){
    
    diskPri64.linePtr: $base
    call Prefixes(=)

    ->Line->
        $base: diskPri64.linePtr
        // does this line start with /dev/<Name>?
        prepare $base, $pTemp@Prefix: Prefix
        call String.StrStarts(=)
        goto_flag not_carry NextLine

        $work@Len: $counter@Len                      // length of the prefix
        $base: diskPri64.linePtr
        _: $pBase[$work]
        compare(_ = 32) goto_true Mounted    // exactly the drive

        compare (diskDk.endsDigit) goto_true DigitName

        compare(_ < 48) goto_true NextLine   // name ends with a letter: partition = digit

        compare(_ > 57) goto_true NextLine
        goto Mounted

    ->DigitName->
        compare(_ != 112) goto_true NextLine // name ends with a digit: partition = 'p' + digit

        $work++
        _: $pBase@Line[$work@Pos]
        compare(_ < 48) goto_true NextLine

        compare(_ > 57) goto_true NextLine
        goto Mounted

    ->NextLine->
        $base: diskPri64.linePtr
        prepare $base, 10
        call String.StrFindChar(=)
        goto_flag not_carry NotMounted       // no more lines

        $counter++
        $base +: $counter@Skip
        diskPri64.linePtr: $base
        _: $pBase[0]
        compare(_ = 0) goto_true NotMounted
        goto Line↑

    ->Mounted->
        compare (diskDk.collect) goto_flag not_carry Hit

        // collect mode: store the mount point and go on with the next line
        call StoreMount(=)
        goto NextLine↑

    ->Hit->
        set_carry
        return

    ->NotMounted->
        compare (diskDk.collect) goto_flag not_carry NoHit

        $value: diskPub64.mntCount
        compare($value = 0) goto_true NoHit

        set_carry
        return

    ->NoHit->
        unset_carry
}

// CopyField: copies a field of the mount table from $temp (up to a space, line end or text end) to $base.
// The sequence "\040" (backslash + 3 octal digits, how the kernel writes spaces in paths) is decoded.
// $work = size of the target (including the final 0). $counter = number of characters read from the source text.
prepare $pBase@Target, $pTemp@Source, $work@Size
public methode CopyField(_, base, temp, work, index, focus counter, value){
    diskPri64.fieldMax: $work@Size
    $index: 0
    $counter: 0

    ->Next->
        _: $pTemp@Source[$counter@Src]
        compare(_ = 32) goto_true Done

        compare(_ = 10) goto_true Done

        compare(_ = 0) goto_true Done

        compare(_ != 92) goto_true Plain

        // backslash: three octal digits?
        $value: $counter
        $value++
        _: $pTemp[$value]
        compare(_ < 48) goto_true Plain

        compare(_ > 55) goto_true Plain

        $work: _
        $work -: 48
        $work <<: 3
        $value++
        _: $pTemp[$value]
        compare(_ < 48) goto_true Plain

        compare(_ > 55) goto_true Plain

        $work +: _
        $work -: 48
        $work <<: 3
        $value++
        _: $pTemp[$value]
        compare(_ < 48) goto_true Plain

        compare(_ > 55) goto_true Plain

        $work +: _
        $work -: 48
        _: $work
        $counter +: 4
        goto Put

    ->Plain->
        _: $pTemp@Source[$counter@Src]
        $counter++

    ->Put->
        $value: diskPri64.fieldMax
        $value--
        compare($index@Out >= $value) goto_true Next↑        // too long: the rest is cut off

        $pBase@Target[$index]: _
        $index++
        goto Next↑

    ->Done->
        $pBase@Target[$index@Out]: 0
}

// StoreMount: remembers device and mount point of the line at LinePtr (at most 8 entries, then MntFull = 1).
public methode StoreMount(_, base, temp, work, index, counter, value){
    $value: diskPub64.mntCount
    compare($value >= 8) goto_true Full

    $index: $value
    $index <<: 6
    $pBase: MntDev
    $pBase +: $index
    prepare $base, $temp@Source: diskPri64.linePtr, $work@Size: 64
    call CopyField(=)

    $temp: diskPri64.linePtr
    $temp +: $counter@Len
    $temp++                              // the mount point begins behind the space
    $value: diskPub64.mntCount
    $index: $value
    $index <<: 8
    $pBase: MntPt
    $pBase +: $index
    prepare $base, $temp, $work: 256
    call CopyField(=)

    diskPub64.mntCount++
    return

    ->Full->
        diskDk.mntFull: true
}

// IsMountedFile: like IsMounted, but reads the mount table from the file $base (path), in blocks of MNT_CHUNK bytes.
// A line may cross a block boundary: only complete lines are checked, the unfinished rest moves to the start of the buffer
// and is completed by the next block. So the table has no size limit.
// Only if the file cannot be read or a single line gets too long, the result is unsure (MountUnsure = 1, carry = 1).
prepare $pBase@Path
public methode IsMountedFile(_, base, temp, work, index, value, counter, item, admin){
    diskDk.mountUnsure: false
    diskDk.mntAny: false
    diskPri64.mntRem: 0
    
    prepare 0, 0, $base
    call Sys.Open(=)
    goto_flag carry Opened
    
    goto Unsure

    ->Opened->
        diskPri64.mntFd: $counter@Fd

    ->More->
        $base: diskPri64.mntFd
        $pTemp: Mounts
        $work: diskPri64.mntRem
        $pTemp +: $work
        
        prepare $base, $temp, $work: MNT_CHUNK
        call Sys.ReadFull(=)
        goto_flag carry Got
        
        goto UnsureClose

    ->Got->
        diskPri64.mntGot: $counter@Got
        $value: diskPri64.mntRem
        $value +: $counter@Got
        diskPri64.mntTotal: $value
        compare($counter = 0) goto_true Eof

        // find the last line end in the buffer
        $work: diskPri64.mntTotal

    ->FindNl->
        compare($work@Pos = 0) goto_true NoNl

        $work--
        _: Mounts[ $work ]
        compare(_ != 10) goto_true FindNl↑

        $work++
        diskPri64.mntCut: $work
        goto Process

    ->NoNl->
        // no complete line yet: keep reading as long as the buffer has room
        $value: diskPri64.mntTotal
        compare($value >= 61440) goto_true UnsureClose

        diskPri64.mntRem: $value
        goto More↑

    ->Process->
        // cut behind the last line end (remember the byte), check, put the byte back
        $work: diskPri64.mntCut
        _: Mounts[ $work ]
        diskPri64.mntSaved: _
        Mounts[ $work ]: 0
        
        prepare $pBase@Mounts: Mounts
        call IsMountedText(=)
        goto_flag not_carry NoHitChunk

        diskDk.mntAny: true
        compare (diskDk.collect) goto_flag not_carry Hit

    ->NoHitChunk->
        $work: diskPri64.mntCut
        _: diskPri64.mntSaved
        Mounts[ $work ]: _
        // move the unfinished rest to the start of the buffer
        $index: 0

    ->Move->
        $work: diskPri64.mntCut
        $work +: $index@Pos
        compare($work >= diskPri64.mntTotal) goto_true Moved

        _: Mounts[ $work ]
        $work: $index
        Mounts[ $work ]: _
        $index++
        goto Move↑

    ->Moved->
        $value: diskPri64.mntTotal
        $value -: diskPri64.mntCut
        diskPri64.mntRem: $value
        goto More↑

    ->Eof->
        // end of file: a last line without a line end is still checked
        $value: diskPri64.mntRem
        compare($value = 0) goto_true Finished

        $work: diskPri64.mntRem
        Mounts[ $work ]: 0
        
        prepare $pBase@Mounts: Mounts
        call IsMountedText(=)
        goto_flag not_carry Finished

        diskDk.mntAny: true

    ->Finished->
        $base: diskPri64.mntFd
        prepare $base
        call Sys.Close(=)

        compare (diskDk.mntAny) goto_flag not_carry Free

        set_carry
        return

    ->Free->
        unset_carry
        return

    ->Hit->
        $base: diskPri64.mntFd
        prepare $base
        call Sys.Close(=)

        set_carry
        return

    ->UnsureClose->
        $base: diskPri64.mntFd
        prepare $base
        call Sys.Close(=)

    ->Unsure->
        diskDk.mountUnsure: true
        set_carry
}

// IsMounted: reads /proc/mounts and checks the drive Name. carry = 1: mounted OR not safely checkable (MountUnsure = 1):
// when in doubt nothing is written.
public methode IsMounted(_, base, temp, work, index, value, counter, item, admin){
    prepare $pBase@Path: "/proc/mounts"
    call IsMountedFile(=)
}

// Collect: like IsMounted, but collects up to 8 mount points of the drive in MntDev / MntPt (MntCount, MntFull).
public methode Collect(_, base, temp, work, index, value, counter, item, admin){
    diskPub64.mntCount: 0
    diskDk.mntFull: false
    diskDk.collect: true
    call IsMounted(=)

    diskDk.collect: false
}

// IsVirtual: is $base the name of a virtual device (loop0, ram0, zram0, dm-0, sr0, fd0, md0, nbd0)? carry = 1: yes
prepare $pBase@Name
public methode IsVirtual(keep base, temp, counter){
    prepare $base, $pTemp@Prefix: "loop" call String.StrStarts(=)
    goto_flag carry Yes

    prepare $base, $pTemp: "ram" call String.StrStarts(=)
    goto_flag carry Yes

    prepare $base, $pTemp: "zram" call String.StrStarts(=)
    goto_flag carry Yes

    prepare $base, $pTemp: "dm-" call String.StrStarts(=)
    goto_flag carry Yes

    prepare $base, $pTemp: "sr" call String.StrStarts(=)
    goto_flag carry Yes

    prepare $base, $pTemp: "fd" call String.StrStarts(=)
    goto_flag carry Yes

    prepare $base, $pTemp: "md" call String.StrStarts(=)
    goto_flag carry Yes

    prepare $base, $pTemp: "nbd" call String.StrStarts(=)
    goto_flag carry Yes

    unset_carry
    return

    ->Yes->
        set_carry
}

// Pad: prints the text $base and fills it with spaces up to $work characters.
prepare $pBase@Text, $work@Width
public methode Pad(_, base, work@Width, item, admin){
    diskPri64.padWidth: $work
    prepare $base@Text call String.StrLen(=)

    $work: _
    prepare $base call Basic.Print(=)

    ->Fill->
        compare($work@Count >= diskPri64.padWidth) goto_true Done

        prepare $pBase@Text: " " call Basic.Print(=)

        $work++
        goto Fill↑

    ->Done->
}

// PadLeft: prints the text $base right-aligned in a field of $work characters.
prepare $pBase@Text, $work@Width
public methode PadLeft(_, base@Text, work@Width, counter, item, admin){
    diskPri64.padText: $base
    diskPri64.padWidth: $work
    prepare $base call String.StrLen(=)

    $counter: _
    $work: diskPri64.padWidth

    ->Fill->
        compare($work@Fill <= $counter@Len) goto_true Show

        prepare $pBase@Text: " " call Basic.Print(=)

        $work--
        goto Fill↑

    ->Show->
        $base: diskPri64.padText
        prepare $base@PadText call Basic.Print(=)
}

// Show: one table row for the drive Name (the properties must have been read with Load).
public methode Show(_, base, temp, work, index, value, counter, item, admin){
    compare (diskDk.numbered) goto_flag not_carry Plain

    // number of the row ("  1) ", "  2) " ...)
    prepare $pBase@Text: "  " call Basic.Print(=)

    $pBase: Num
    prepare $base, $value@Number: diskPri64.showNo call Basic.ItoA(=)

    prepare $pBase: Num call Basic.Print(=)

    prepare $pBase: ") " call Basic.Print(=)
    goto Number

    ->Plain->
        prepare $pBase@Text: "  " call Basic.Print(=)

    ->Number->
        prepare $pBase@Text: Name, $work@Width: 12
        call Pad(=)

        $pBase: Num
        $value: diskPub64.sectors
        $value /: 2048
        prepare $base, $value call Basic.ItoA(=)

        prepare $pBase: Num, $work: 8
        call PadLeft(=)

        prepare $pBase: " MiB  " call Basic.Print(=)

        compare (diskDk.removable) goto_true Rem

        prepare $pBase: "fixed      " call Basic.Print(=)
        goto Mod

    ->Rem->
        prepare $pBase@Text: "removable  " call Basic.Print(=)

    ->Mod->
        call Model(=)

        prepare $pBase@Text: Text, $work@Width: 28
        call Pad(=)

        call IsMounted(=)
        goto_flag carry Mnt

        prepare $pBase@Text: "\n" call Basic.Print(=)
        return

    ->Mnt->
        prepare $pBase@Text: "MOUNTED\n" call Basic.Print(=)
}

// SortNames: sorts the names in Names (ListCount of them, 32 bytes each) alphabetically, so the numbers stay stable.
public methode SortNames(base, temp, work, index, counter, item, admin){
    $index: 1

    ->Outer->
        compare($index@Outer >= diskPub64.listCount) goto_true Done

        // SortTmp = Names[index]
        $work: $index
        $work <<: 5
        $pTemp: Names
        $pTemp +: $work
        prepare $pBase@SortTmp: SortTmp, $temp
        call String.StrCopy(=)

        $work: $index

    ->Inner->
        compare($work@Pos = 0) goto_true Place

        // compare Names[work-1] with SortTmp
        $counter: $work
        $counter--
        $counter <<: 5
        $pBase: Names
        $pBase +: $counter
        prepare $base, $pTemp@SortTmp: SortTmp
        call String.StrCompare(=)
        goto_flag carry Place

        compare($counter > 255) goto_true Place     // negative = Names[work-1] already comes first

        // Names[work] = Names[work-1]
        $counter: $work
        $counter <<: 5
        $pBase: Names
        $pBase +: $counter
        $counter: $work
        $counter--
        $counter <<: 5
        $pTemp: Names
        $pTemp +: $counter
        prepare $base, $temp
        call String.StrCopy(=)

        $work--
        goto Inner↑

    ->Place->
        $work <<: 5
        $pBase: Names
        $pBase +: $work@Offset
        prepare $base, $pTemp@SortTmp: SortTmp
        call String.StrCopy(=)

        $index++
        goto Outer↑

    ->Done->
}

// List: prints a table of the drives. ListAll = 0: only removable drives, 1: all (except virtual devices).
// Result: ListCount = number of rows. carry = 0: /sys/block cannot be read.
public methode List(_, base, temp, work, index, value, counter, item, admin){
    diskPub64.listCount: 0
    $pBase: "/sys/block"
    prepare 65536, 0, $base@Text
    call Sys.Open(=)
    goto_flag not_carry Fail

    diskPri64.dirFd: $counter@Fd

    ->More->
        $base: diskPri64.dirFd
        $pTemp: Dents
        prepare 4096, $base, $temp
        call Sys.GetDents(=)
        goto_flag not_carry Done

        compare($counter@Got = 0) goto_true Done

        diskPri64.dentsLen: $counter
        diskPri64.dentsPos: 0

    ->Entry->
        $index: diskPri64.dentsPos
        $work: diskPri64.dentsLen
        compare($index >= $work)
        goto_true More↑

        $pBase: Dents
        $pBase +: $index                     // start of the entry
        _: $pBase[16]                        // d_reclen, low byte
        $work@RecLen: $pBase[17]             // high byte
        $work <<: 8
        $work +: _
        $index +: $work@RecLen
        diskPri64.dentsPos: $index                     // next entry
        $base +: 19                          // name
        
        _: $pBase[0]
        compare(_ = 46) 
        goto_true Entry↑     // "." and ".." and hidden names

        prepare $base
        call IsVirtual(=)
        goto_flag carry Entry↑

        $temp: $base
        $pBase: Name
        prepare $base, $temp, 32
        call String.StrCopyN(=)
        goto_flag not_carry Entry↑           // name too long

        call Load(=)
        goto_flag not_carry Entry↑

        compare (diskDk.removable) goto_true Take

        compare (diskDk.listAll) goto_flag not_carry Entry↑

    ->Take->
        $value: diskPub64.listCount
        compare($value >= 16) goto_true Entry↑      // more than 16 drives are not offered

        $value <<: 5
        $pBase: Names
        $pBase +: $value
        prepare $base, $pTemp@Name: Name
        call String.StrCopy(=)

        diskPub64.listCount++
        goto Entry↑

    ->Done->
        $base: diskPri64.dirFd
        prepare $base
        call Sys.Close(=)

        call SortNames(=)

        // print the table: read the properties of every drive again
        $index: 0

    ->Rows->
        compare($index@Row >= diskPub64.listCount)
        goto_true Shown

        $work: $index
        $work <<: 5
        $pTemp: Names
        $pTemp +: $work
        prepare $pBase@Name: Name, $temp
        call String.StrCopy(=)

        diskPri64.dentsPos: $index                     // counter of the display (Dents is not needed any more)
        call Load(=)

        $index: diskPri64.dentsPos
        $index++
        diskPri64.showNo: $index
        call Show(=)

        $index: diskPri64.showNo
        goto Rows↑

    ->Shown->
        $value: diskPub64.listCount
        compare($value != 0)
        goto_true Listed

        prepare $pBase@Text: "  (no drives found)\n"
        call Basic.Print(=)

    ->Listed->
        set_carry
        return

    ->Fail->
        unset_carry
}
